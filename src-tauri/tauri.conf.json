{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kingdom Passion Academy",
  "version": "0.1.0",
  "identifier": "cm.kingdompassionacademy.os",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kingdom Passion Academy — School Operations System",
        "url": "http://localhost:4173",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "externalBin": ["binaries/kpa-local-server"],
    "resources": ["../local-server-dist/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "French"]
      }
    }
  }
}
