# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local-first mode (Windows desktop app only — leave BOTH unset for the
# normal Vercel/web deployment, which always talks to Supabase directly)
# DATA_MODE=local
# LOCAL_DB_DIR=C:\Users\<you>\AppData\Roaming\kpa-os
# Signs the offline PIN session cookie so it can't be edited in devtools to
# claim a different role. Generate once with `openssl rand -hex 32` and keep
# it identical across app updates (changing it logs everyone out).
# LOCAL_SESSION_SECRET=

# AI Gateway — always route through OpenRouter, never expose provider/model names client-side
OPENROUTER_API_KEY=

# SMS Gateway (Cameroon — MTN/Orange aggregator, e.g. Nsimi, MesageBird, or local reseller)
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=KPA

# Automated weekly fee reminders (Vercel Cron only — cloud deployment)
CRON_SECRET=

# CamPay — online fee payments via MTN MoMo / Orange Money (parent portal)
# Get your permanent token from campay.net → App Keys. Use demo.campay.net
# (CAMPAY_ENV unset) for testing before switching to production.
CAMPAY_ENV=demo
CAMPAY_PERMANENT_TOKEN=

# Note: ID card QR codes are rendered via the free api.qrserver.com image API
# (no key needed). Swap for a self-hosted QR generator later if offline
# generation becomes a requirement.
